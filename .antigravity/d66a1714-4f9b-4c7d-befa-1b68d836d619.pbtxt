    instruction: "Apply the \"Professional Polish\" design style including top nav, footer, and updated container styling to the current app component"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"min-h-screen bg-[#0F172A] text-slate-200 p-8 flex justify-center items-start pt-16 font-sans\">\n      <div className=\"w-full max-w-3xl\">\n        <div className=\"flex items-center gap-3 mb-8\">\n          <div className=\"p-3 bg-blue-500/20 rounded-xl\">\n            <Database className=\"w-6 h-6 text-blue-400\" />\n          </div>\n          <div>\n            <h1 className=\"text-2xl font-semibold tracking-tight text-white mb-1\">Qlik MCP Server</h1>\n            <p className=\"text-sm text-slate-400\">Function calling backend for Qlik script comparison</p>\n          </div>\n        </div>\n\n        <div className=\"bg-[#1E293B] border border-slate-700/50 p-6 rounded-2xl shadow-xl mb-6\">\n          <form onSubmit={handleSubmit} className=\"flex flex-col gap-4\">\n            <div>\n              <label htmlFor=\"prompt\" className=\"block text-sm font-medium text-slate-400 mb-2\">\n                Gemini Prompt\n              </label>\n              <textarea\n                id=\"prompt\"\n                className=\"w-full bg-[#0F172A] border border-slate-700 rounded-xl p-4 text-slate-200 placeholder:text-slate-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 resize-y min-h-[120px]\"\n                value={prompt}\n                onChange={(e) => setPrompt(e.target.value)}\n                placeholder=\"Ask the AI to compare Qlik app scripts...\"\n              />\n            </div>\n            \n            <button\n              type=\"submit\"\n              disabled={loading || !prompt.trim()}\n              className=\"self-end px-6 py-3 bg-blue-600 hover:bg-blue-500 disabled:bg-blue-900/50 disabled:text-slate-500 text-white font-medium rounded-xl flex items-center gap-2 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500/50\"\n            >\n              {loading ? <Loader2 className=\"w-5 h-5 animate-spin\" /> : <Play className=\"w-5 h-5 fill-current\" />}\n              Execute Request\n            </button>\n          </form>\n        </div>\n\n        {result && (\n          <div className=\"bg-[#1E293B] border border-slate-700/50 rounded-2xl shadow-xl overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500\">\n            <div className=\"p-4 border-b border-slate-700/50 bg-slate-800/50 flex items-center gap-2\">\n              <ArrowRightLeft className=\"w-4 h-4 text-emerald-400\" />\n              <h3 className=\"text-sm font-medium text-slate-300\">MCP Execution Result</h3>\n            </div>\n            <div className=\"p-0\">\n              <pre className=\"p-6 text-sm font-mono text-emerald-400 overflow-x-auto\">\n                {JSON.stringify(result, null, 2)}\n              </pre>\n            </div>\n          </div>\n        )}\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"flex flex-col h-screen w-full bg-slate-100 text-slate-900 font-sans\">\n      {/* Top Navigation Bar */}\n      <header className=\"h-16 flex items-center justify-between px-6 border-b border-slate-200 bg-white shrink-0\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"bg-blue-600 p-2 rounded\">\n            <Database className=\"w-5 h-5 text-white\" />\n          </div>\n          <div>\n            <h1 className=\"text-lg font-bold text-slate-800 tracking-tight\">MCP Qlik Sense Utility</h1>\n            <p className=\"text-xs text-slate-500 font-medium uppercase tracking-widest\">Script Comparison & Reporting Tool</p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <div className=\"flex items-center gap-2 px-3 py-1 bg-green-50 border border-green-200 rounded-full\">\n            <div className=\"w-2 h-2 bg-green-500 rounded-full animate-pulse\"></div>\n            <span className=\"text-xs font-semibold text-green-700\">MCP Server: Active</span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Workspace */}\n      <main className=\"flex-1 flex flex-col overflow-y-auto items-center p-8\">\n        <div className=\"w-full max-w-4xl space-y-6\">\n          <div className=\"bg-white border border-slate-200 p-6 rounded shadow-sm\">\n            <div className=\"flex items-center gap-2 mb-4\">\n              <div className=\"p-1.5 bg-blue-100 rounded text-blue-600\">\n                <Play className=\"w-4 h-4 fill-current\" />\n              </div>\n              <h2 className=\"text-sm font-bold text-slate-700\">AI Prompt Execution</h2>\n            </div>\n            \n            <form onSubmit={handleSubmit} className=\"flex flex-col gap-4\">\n              <div>\n                <label htmlFor=\"prompt\" className=\"block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2\">\n                  Gemini Prompt\n                </label>\n                <textarea\n                  id=\"prompt\"\n                  className=\"w-full bg-white border border-slate-300 rounded focus:ring-1 focus:ring-blue-500 outline-none py-2 px-3 text-sm text-slate-700 placeholder-slate-400 resize-y min-h-[100px]\"\n                  value={prompt}\n                  onChange={(e) => setPrompt(e.target.value)}\n                  placeholder=\"Ask the AI to compare Qlik app scripts...\"\n                />\n              </div>\n              \n              <button\n                type=\"submit\"\n                disabled={loading || !prompt.trim()}\n                className=\"self-end px-4 py-2 bg-blue-600 hover:bg-blue-700 disabled:bg-slate-300 disabled:text-slate-500 text-white rounded-md text-sm font-medium shadow-sm transition-colors border border-transparent flex items-center gap-2 focus:outline-none focus:ring-2 focus:ring-blue-500/50\"\n              >\n                {loading ? <Loader2 className=\"w-4 h-4 animate-spin\" /> : <Play className=\"w-4 h-4 fill-current\" />}\n                Execute Run\n              </button>\n            </form>\n          </div>\n\n          {result && (\n            <div className=\"bg-white border border-slate-300 rounded shadow-sm overflow-hidden animate-in fade-in slide-in-from-bottom-4 duration-500\">\n              <div className=\"h-12 border-b border-slate-200 bg-slate-50 flex items-center px-6 gap-3\">\n                <ArrowRightLeft className=\"w-4 h-4 text-blue-600\" />\n                <h3 className=\"text-sm font-bold text-slate-700\">Execution Result</h3>\n              </div>\n              <div className=\"p-0 border-t border-white\">\n                <pre className=\"p-6 text-[11px] leading-relaxed font-mono text-slate-700 bg-slate-50 overflow-x-auto\">\n                  {JSON.stringify(result, null, 2)}\n                </pre>\n              </div>\n            </div>\n          )}\n        </div>\n      </main>\n\n      {/* Bottom Status Bar */}\n      <footer className=\"h-8 bg-slate-800 text-slate-400 flex items-center justify-between px-4 text-[10px] shrink-0\">\n        <div className=\"flex items-center gap-4\">\n          <span className=\"flex items-center gap-1.5\">\n            <span className=\"w-1.5 h-1.5 rounded-full bg-green-500\"></span> Local MCP Connected\n          </span>\n          <span>Port: 3000</span>\n        </div>\n        <div className=\"flex items-center gap-3\">\n          <span className=\"hover:text-white cursor-pointer transition-colors\">Documentation</span>\n          <span className=\"text-slate-600 font-mono\">ID: QLX-MCP-01</span>\n        </div>\n      </footer>\n    </div>\n  );"
